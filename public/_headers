# Header definitions for Cloudflare Workers static assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Note: when several rules match, headers with the same name are joined with commas
# (two CSPs become their intersection and break things), so write the CSP only in the
# single /* block below.
#
# Playback is done entirely in iframes; the YouTube IFrame Player API (an external
# script) is not loaded. Mute control and error detection only need postMessage with
# enablejsapi=1, so script-src can stay 'self'. frame-src is the playback iframe.
# open-meteo in connect-src is the local weather of the selected camera (no key, CORS *).
# *.wikipedia.org is the overview of the selected camera's place (no key, CORS *).
# api.mymemory.translated.net translates overviews of articles with no Japanese version
# into Japanese (no key, CORS *).
# tile.openstreetmap.org is for the flat map (Leaflet <img>). Country names and borders
# on the globe are bundled GeoJSON. Only the shaded-relief raster and text glyphs from
# tiles.openfreemap.org are allowed in connect-src / img-src.
#
# compute-pressure is delegated only to the playback origin. If it stays denied, the
# player retries endlessly and, with 4 streams side by side, hundreds of violation logs
# per second crash the whole tab (measured). This hands coarse CPU load only to the party
# already streaming the video.
#
# /api/* is served by the Worker, so _headers does not apply. worker/index.ts adds those headers.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://tiles.openfreemap.org https://i.ytimg.com; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://*.wikipedia.org https://api.mymemory.translated.net https://tile.openstreetmap.org https://tiles.openfreemap.org; frame-src https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), compute-pressure=(self "https://www.youtube-nocookie.com")
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Vite emits these with content hashes, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The camera master data. It has a fixed name without a content hash, so it cannot be
# immutable (cameras someone adds would never reach users). Keep it short-lived and
# refetch in the background.
/cams.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
