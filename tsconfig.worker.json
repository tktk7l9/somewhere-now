{
  // The Worker is checked against the Workers runtime types, not the DOM. Only src/domain
  // is shared, so it is included (the Worker never references the UI layer).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals", "@cloudflare/workers-types"]
  },
  "include": ["worker", "src/domain", "src/data"],
  // Tests under src use node and vite types, so leave them to the main tsconfig
  // (they cannot be resolved with the Worker types alone).
  "exclude": ["src/**/*.test.ts"]
}
