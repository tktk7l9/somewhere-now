/**
 * somewhere-now — Cloudflare Workers
 * https://developers.cloudflare.com/workers/static-assets/
 *
 * Has a Worker script in addition to the static assets (Vite's dist):
 *   - fetch     ... returns the live liveness state (KV) at /api/cams
 *   - scheduled ... calls the YouTube Data API from a Cron Trigger and updates KV
 *
 * Static assets are resolved first, and only paths that do not match reach the Worker.
 * Security headers take effect through public/_headers being copied into dist
 * (but _headers only applies to static assets, so worker/index.ts sets the headers
 *  for paths under /api/ itself).
 *
 * YOUTUBE_API_KEY is set with `wrangler secret put YOUTUBE_API_KEY`
 * (locally it is .dev.vars. Neither goes into git).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somewhere-now",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // All state lives in query parameters, so SPA routing is not needed.
    "not_found_handling": "404-page",
  },
  "kv_namespaces": [
    {
      "binding": "CAM_STATE",
      "id": "3a47608f6d7e4e0a9bb43c824ee5dee8",
    },
  ],
  // Kept as a pair with CRON in worker/schedule.ts (schedule.test.ts cross-checks them).
  // Rediscovery sits at :05 because on the hour it would fire together with the 10-minute
  // liveness sweep, both would read and write the same source of truth, and with last write
  // wins the consumption and state of one of them would be lost.
  "triggers": {
    "crons": [
      "*/10 * * * *", // liveness sweep: videos.list (1 unit / 50 items)
      "5 * * * *", // rediscovery: search.list (100 units), within the budget
    ],
  },
  "observability": {
    "enabled": true,
  },
}
